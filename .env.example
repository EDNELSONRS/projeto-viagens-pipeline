# Copie este arquivo para .env e informe a senha local do PostgreSQL.
# Nunca envie .env ao GitHub.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=COLE_SUA_SENHA_AQUI
POSTGRES_DATABASE=transparencia_viagens

# Opcional: ID do ZIP compartilhado no Google Drive. Se o arquivo já estiver
# em data/viagens_2025_6meses.zip, o download não será necessário.
DRIVE_FILE_ID=
